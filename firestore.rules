rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any user to read sync documents
    match /user_sync/{userId} {
      allow read: if true;
      allow write: if false; 
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
