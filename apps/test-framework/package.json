{
  "name": "test-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:emulator": "npx tsx ./src/scripts/start-emulator.ts",
    "build:apk:stage": "npx tsx ./src/scripts/build-apk.ts --stage",
    "build:apk:prod": "npx tsx ./src/scripts/build-apk.ts --prod",
    "test:mobile:run": "npm run start:emulator && npx wdio run ./src/mobile/wdio.conf.ts",
    "test:mobile:e2e:stage": "npm run build:apk:stage && npm run test:mobile:run",
    "test:mobile:e2e:prod": "npm run build:apk:prod && npm run test:mobile:run",
    "test:api": "npx playwright test --grep \"@smoke\" --grep-invert \"@bug\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "wdio-wait-for": "^3.1.1"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "kysely": "^0.28.11",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.6",
    "pg": "^8.18.0"
  }
}
