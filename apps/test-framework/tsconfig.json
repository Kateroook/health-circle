{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"]
    },
    "types": [
      "node",
      "webdriverio",
      "@wdio/globals/types",
      "@wdio/mocha-framework"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}