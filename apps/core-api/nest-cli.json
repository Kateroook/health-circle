{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      {
        "include": "common/assets/**/*.{hbs,xlsx,csv,pdf,png,jpg}",
        "outDir": "dist/src"
      }
    ]
  }
}
